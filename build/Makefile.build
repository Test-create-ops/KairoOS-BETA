CC = x86_64-elf-gcc
LD = x86_64-elf-ld
AS = nasm

CFLAGS = -m64 -ffreestanding -O2 -Wall -Wextra -mno-red-zone -mcmodel=kernel -fno-pie -fno-stack-protector -mno-sse -mno-sse2 -Wa,-noexecstack
ASFLAGS = -f elf64
LDFLAGS = -m elf_x86_64 -T build/linker.ld -nostdlib

C_OBJS = kernel/kernel.o

ASM_OBJS = kernel/asm/boot_entry.o \
           kernel/asm/gdt_flush.o \
           kernel/asm/tss_flush.o \
           kernel/asm/idt_flush.o \
           kernel/asm/context_switch.o \
           kernel/asm/usermode_trampoline.o \
            kernel/asm/irq1_keyboard_stub.o

OBJS = $(C_OBJS) $(ASM_OBJS)

all: kernel.bin

kernel.bin: $(OBJS) build/linker.ld
	$(LD) $(LDFLAGS) -o $@ $(OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

kernel/asm/%.o: kernel/asm/%.asm
	$(AS) $(ASFLAGS) $< -o $@

clean:
	rm -f $(OBJS) kernel.bin
